generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  MANAGER
  MEMBER
}

enum CycleStatus {
  PLANNING
  ACTIVE
  CLOSED
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

enum HealthStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

enum InitiativeStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  memberships  Membership[]
  updates      WeeklyUpdate[]
}

model Workspace {
  id          String       @id @default(cuid())
  name        String
  memberships Membership[]
  cycles      Cycle[]
}

model Membership {
  id              String      @id @default(cuid())
  userId          String
  workspaceId     String
  role            Role
  user            User        @relation(fields: [userId], references: [id])
  workspace       Workspace   @relation(fields: [workspaceId], references: [id])
  objectives      Objective[]
  ownedKeyResults KeyResult[]
  initiatives     Initiative[]

  @@unique([userId, workspaceId])
}

model Cycle {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  startDate   DateTime
  endDate     DateTime
  status      CycleStatus @default(ACTIVE)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  objectives  Objective[]
}

model Objective {
  id                String      @id @default(cuid())
  cycleId           String
  title             String
  ownerMembershipId String
  cycle             Cycle       @relation(fields: [cycleId], references: [id])
  owner             Membership  @relation(fields: [ownerMembershipId], references: [id])
  keyResults        KeyResult[]
}

model KeyResult {
  id                String         @id @default(cuid())
  objectiveId       String
  ownerMembershipId String
  title             String
  metricUnit        String
  baseline          Float
  target            Float
  objective         Objective      @relation(fields: [objectiveId], references: [id])
  owner             Membership     @relation(fields: [ownerMembershipId], references: [id])
  updates           WeeklyUpdate[]
  initiatives       Initiative[]
}

model Initiative {
  id                String           @id @default(cuid())
  keyResultId       String
  ownerMembershipId String
  title             String
  status            InitiativeStatus @default(NOT_STARTED)
  dueDate           DateTime?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  keyResult         KeyResult        @relation(fields: [keyResultId], references: [id])
  owner             Membership       @relation(fields: [ownerMembershipId], references: [id])
}

model WeeklyUpdate {
  id          String       @id @default(cuid())
  keyResultId String
  userId      String
  weekStart   DateTime
  value       Float
  confidence  Confidence
  status      HealthStatus
  blockers    String?
  nextStep    String
  createdAt   DateTime     @default(now())
  keyResult   KeyResult    @relation(fields: [keyResultId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@unique([keyResultId, weekStart])
}
